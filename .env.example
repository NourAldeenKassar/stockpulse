DATABASE_URL=postgresql://postgres:postgres@localhost:5436/trading212_copilot

# Must be at least 32 characters, and the two must differ.
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-string

# Exactly 64 hex characters (32 bytes) for AES-256.
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-for-aes256-encryption-key00

TRADING212_BASE_URL=https://live.trading212.com

# Port the API listens on, and the origin allowed to call it.
# Comma-separate FRONTEND_ORIGIN for more than one.
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
