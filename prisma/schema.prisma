generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String           @id @default(uuid())
  email                   String           @unique
  passwordHash            String
  llmGatewayUrl           String?
  llmGatewayKeyEncrypted  String?
  llmGatewayKeyIv         String?
  llmGatewayKeyTag        String?
  finnhubKeyEncrypted     String?
  finnhubKeyIv            String?
  finnhubKeyTag           String?
  createdAt               DateTime         @default(now())
  accounts                TradingAccount[]

  @@map("users")
}

model TradingAccount {
  id                     String              @id @default(uuid())
  label                  String              @default("Main")
  apiKeyEncrypted        String
  encryptionIv           String
  encryptionTag          String
  apiSecretEncrypted     String
  secretEncryptionIv     String
  secretEncryptionTag    String
  snapshotIntervalMin Int                 @default(1440)
  lastSnapshotAt      DateTime?
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots           PortfolioSnapshot[]
  insights            InsightRecord[]
  stockAnalyses       StockAnalysis[]

  @@map("trading_accounts")
}

model InsightRecord {
  id        String         @id @default(uuid())
  accountId String
  account   TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  insights  Json
  createdAt DateTime       @default(now())

  @@index([accountId, createdAt])
  @@map("insight_records")
}

model PortfolioSnapshot {
  id         String         @id @default(uuid())
  accountId  String
  account    TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  takenAt    DateTime       @default(now())
  totalValue Float
  cash       Float
  invested   Float
  ppl        Float
  result     Float
  positions  Json

  @@index([accountId, takenAt])
  @@map("portfolio_snapshots")
}

/// A cached per-stock analysis: real analyst consensus plus the AI narrative
/// written around it. Cached so reopening a stock does not re-bill a paid
/// provider.
model StockAnalysis {
  id        String         @id @default(uuid())
  accountId String
  account   TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Trading212 ticker, e.g. AAPL_US_EQ
  ticker    String
  /// Resolved market-data symbol, e.g. AAPL. Null when it could not be mapped.
  symbol    String?
  /// Finnhub recommendation trends. Null when no symbol could be resolved.
  consensus Json?
  /// The model-written narrative.
  analysis  Json
  provider  String
  model     String
  createdAt DateTime       @default(now())

  @@index([accountId, ticker, createdAt])
  @@map("stock_analyses")
}
